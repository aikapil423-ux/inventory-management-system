{
  "version": 2,
  "builds": [
    { "src": "client/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/inventory-app/api/index.js" },
    { "src": "/(.*)", "dest": "build/$1" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/inventory-app/api/index" }
  ],
  "env": {
    "REACT_APP_API_URL": "@API_URL"
  }
}