{
  "version": 2,
  "builds": [
    { "src": "client/package.json", "use": "@vercel/static-build", "config": { "distDir": "client/build" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/inventory-app/api/index.js" },
    { "src": "/(.*)", "dest": "client/build/$1" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/inventory-app/api/index" }
  ]
}